# ===== Server =====
SERVER_URL=http://localhost:8080

# ===== MySQL =====
DB_URL=jdbc:mysql://localhost:3306/calenduck?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=your_db_password

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== JWT =====
JWT_SECRET_KEY=your_jwt_secret_key_base64_encoded

# ===== Kakao OAuth =====
KAKAO_CLIENT_ID=your_kakao_client_id
KAKAO_REDIRECT_URL=http://localhost:8080/auth/kakao/callback

# ===== Redash API =====
REDASH_API_KEY_GENRE_REGION=your_redash_genre_region_api_key
REDASH_API_KEY_TOP_TEN=your_redash_top_ten_api_key
REDASH_API_KEY_REGION=your_redash_region_api_key

# ===== KOPIS API =====
KOPIS_API_SERVICE_KEY=your_kopis_service_key
